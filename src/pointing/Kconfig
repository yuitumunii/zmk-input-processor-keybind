if ZMK_POINTING

config ZMK_INPUT_PROCESSOR_KEYBIND
    bool "Split Payload Compression Input Processor"
    default y
    depends on DT_HAS_ZMK_INPUT_PROCESSOR_KEYBIND_ENABLED

config ZMK_INPUT_PROCESSOR_KEYBIND_CODES_MAX_LEN
    int "Maximum codes length"
    default 4

config ZMK_INPUT_PROCESSOR_KEYBIND_STUDIO_RPC
    bool "Live gesture tuning over a custom Studio RPC subsystem"
    default n
    depends on ZMK_INPUT_PROCESSOR_KEYBIND && ZMK_STUDIO
    help
      Exposes each zip_keybind processor's tick / wait-ms / threshold params
      over a custom Studio RPC subsystem so they can be changed live from the
      desktop app without reflashing. Requires a ZMK base with custom-subsystem
      support (cormoran custom-studio-protocol).

config ZMK_INPUT_PROCESSOR_KEYBIND_DYNAMIC
    bool "Dynamic (layer-aware) trackball gesture input processor"
    default y
    depends on DT_HAS_ZMK_INPUT_PROCESSOR_KEYBIND_DYNAMIC_ENABLED
    help
      Adds the zip_keybind_dynamic processor which inspects the highest
      active layer on every trackball event and fires per-layer configured
      bindings.  Layers with no binding configured pass events through so
      normal cursor processing is unaffected.

endif
